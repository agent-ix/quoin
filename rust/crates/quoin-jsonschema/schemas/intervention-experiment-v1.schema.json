{
  "$id": "https://agent-ix.github.io/quoin/schemas/intervention-experiment-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "baseline": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "type": "object"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "population": {
          "minLength": 1,
          "type": "string"
        },
        "sample_size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "population",
        "sample_size",
        "configuration"
      ],
      "type": "object"
    },
    "changed_variables": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "baseline_value": {},
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "treatment_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "treatment_value": {}
        },
        "required": [
          "name",
          "treatment_id",
          "baseline_value",
          "treatment_value"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "conclusion": {
      "additionalProperties": false,
      "properties": {
        "attribution_confidence": {
          "enum": [
            "none",
            "low",
            "moderate",
            "high"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "causal_effect_established",
            "no_effect_observed",
            "cause_not_established"
          ],
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "statement",
        "attribution_confidence"
      ],
      "type": "object"
    },
    "confounders": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "disposition": {
            "enum": [
              "controlled",
              "uncontrolled",
              "unknown",
              "not_applicable"
            ],
            "type": "string"
          }
        },
        "required": [
          "description",
          "disposition"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "design": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "not_applicable",
                "deterministic",
                "randomized",
                "blocked_randomized"
              ],
              "type": "string"
            },
            "seed": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "method"
          ],
          "type": "object"
        },
        "kind": {
          "enum": [
            "repeated",
            "randomized",
            "factorial"
          ],
          "type": "string"
        },
        "repetitions": {
          "minimum": 1,
          "type": "integer"
        },
        "sampling_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "repetitions",
        "assignment",
        "sampling_conditions"
      ],
      "type": "object"
    },
    "gaps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "held_constant": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "name",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "interactions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "disposition": {
            "enum": [
              "controlled",
              "uncontrolled",
              "unknown",
              "not_applicable"
            ],
            "type": "string"
          }
        },
        "required": [
          "description",
          "disposition"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "measured_effects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "baseline_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "effect": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "metric": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "treatment_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "treatment_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "treatment_id",
          "metric",
          "baseline_value",
          "treatment_value",
          "effect",
          "unit"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "definition_version": {
          "minLength": 1,
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "type": "object"
        },
        "source_revision": {
          "minLength": 1,
          "type": "string"
        },
        "tool_identity": {
          "minLength": 1,
          "type": "string"
        },
        "tool_version": {
          "pattern": "^(v?[0-9]+[.][0-9]+[.][0-9]+([-+][0-9A-Za-z.-]+)?|[a-f0-9]{40}|sha256:[a-f0-9]{64})$",
          "type": "string"
        }
      },
      "required": [
        "tool_identity",
        "tool_version",
        "configuration_digest",
        "source_revision",
        "environment",
        "definition_version"
      ],
      "type": "object"
    },
    "raw_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "media_type",
          "size_bytes",
          "digest"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "record_type": {
      "const": "intervention_experiment"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "inconclusive"
      ],
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "treatments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "type": "object"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "population": {
            "minLength": 1,
            "type": "string"
          },
          "sample_size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "population",
          "sample_size",
          "configuration"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "observed_at",
    "subject",
    "producer",
    "design",
    "baseline",
    "treatments",
    "changed_variables",
    "held_constant",
    "measured_effects",
    "interactions",
    "confounders",
    "status",
    "conclusion",
    "gaps",
    "owner",
    "actions",
    "raw_evidence"
  ],
  "type": "object"
}
