{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ix.github.io/quoin/schemas/gsn-case-v1.schema.json",
  "title": "Quoin GSN case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "nodes", "edges", "roots", "unreachable", "unmapped"],
  "properties": {
    "format": { "const": "quoin.gsn-case/v1" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "roots": { "type": "array", "items": { "type": "string" } },
    "unreachable": { "type": "array", "items": { "type": "string" } },
    "unmapped": { "type": "array", "items": { "$ref": "#/$defs/unmapped" } },
    "signed_acceptance": { "$ref": "#/$defs/signed-acceptance" }
  },
  "$defs": {
    "signed-acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "record_id", "record_digest", "tag", "approver", "meaning", "signer_source", "trusted_at_missing"],
      "properties": {
        "label": { "const": "Human acceptance of case content" },
        "record_id": { "const": "quoin.gsn-case/v1" },
        "record_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "tag": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "meaning": { "const": ["assurance-case-accepted"] },
        "signer_source": { "const": "allowed_signers" },
        "signed_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "signed_at_source": { "const": "tagger_date" },
        "signed_at_missing": { "const": "tagger_date_unreadable" },
        "trusted_at_missing": { "const": "ssh_signature" }
      },
      "oneOf": [
        { "required": ["signed_at", "signed_at_source"], "not": { "required": ["signed_at_missing"] } },
        { "required": ["signed_at_missing"], "not": { "anyOf": [{ "required": ["signed_at"] }, { "required": ["signed_at_source"] }] } }
      ]
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "source", "statement", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["goal", "strategy", "solution", "context", "assumption", "justification", "counter_claim"] },
        "source": { "type": "string", "minLength": 1 },
        "statement": { "type": "string" },
        "status": { "enum": ["supported", "open"] },
        "openReason": { "type": "string" },
        "undeveloped": { "type": "boolean" },
        "evidence": {},
        "sourceData": {}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "from", "to"],
      "properties": { "kind": { "enum": ["supported_by", "in_context_of", "challenges"] }, "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "unmapped": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": { "source": { "type": "string" }, "reason": { "type": "string" } }
    }
  }
}
