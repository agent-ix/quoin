{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/semantic-core/0.1.0/FormatConstraint.json",
	"type": "object",
	"properties": {
		"keyword": {
			"type": "string",
			"const": "format"
		},
		"name": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"
		}
	},
	"required": ["keyword", "name"],
	"unevaluatedProperties": {
		"not": {}
	}
}
