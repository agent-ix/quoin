{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ix.dev/schemas/quire/clause-binding-v1.schema.json",
  "title": "Quire clause binding report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "clauseSet",
    "clauseSetDigest",
    "context",
    "clauses"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "clause-binding-v1" },
    "clauseSet": { "$ref": "#/$defs/key" },
    "clauseSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "clauses": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "engine": { "$ref": "#/$defs/engine" }
  },
  "$defs": {
    "key": {
      "type": "object",
      "required": ["authority", "id", "version"],
      "additionalProperties": false,
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "clauseId",
        "force",
        "outcome",
        "reasons",
        "expectedOutputs"
      ],
      "additionalProperties": false,
      "properties": {
        "clauseId": { "type": "string", "minLength": 1 },
        "force": {
          "enum": ["mandatory", "recommended", "permitted"]
        },
        "outcome": {
          "enum": ["binding", "not_binding", "unresolved"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "dimension": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        },
        "expectedOutputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "engine": {
      "type": "object",
      "required": ["cli", "engine", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "cli": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
