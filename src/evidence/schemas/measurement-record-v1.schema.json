{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ix.dev/quoin/schemas/measurement-record-v1.schema.json",
  "title": "Quoin MeasurementRecord v1",
  "description": "A policy-free observation linked to an authored measurement plan and a versioned measure definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plan",
    "subject",
    "scope",
    "sourceRevision",
    "value",
    "unit",
    "tool",
    "environment",
    "collectedAt",
    "rawEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definitionVersion"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "definitionVersion": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "anyOf": [
        { "required": ["minimum"] },
        { "required": ["maximum"] },
        { "required": ["mean"] },
        { "required": ["standardDeviation"] },
        { "required": ["quantiles"] }
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "mean": { "type": "number" },
        "standardDeviation": { "type": "number", "minimum": 0 },
        "quantiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["probability", "value"],
            "properties": {
              "probability": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "value": { "type": "number" }
            }
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configurationDigest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configurationDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sampleCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sampleCount": { "type": "integer", "minimum": 1 }
      }
    },
    "collectedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "rawEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "reference": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*:[A-Fa-f0-9]+$"
    }
  }
}
